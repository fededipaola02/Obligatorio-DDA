@page "/equipos/nuevo"
@rendermode InteractiveServer
@inject ServicioEquipos ApiService
@inject NavigationManager Nav

<PageTitle>Nuevo Equipo</PageTitle>

<h2>Nuevo Equipo</h2>

<a href="/equipos" class="btn btn-secondary mb-3">← Volver al listado</a>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <EditForm Model="@modelo" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nombre <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="modelo.Nombre" placeholder="Ej: Camión Utilitario 01" />
                <ValidationMessage For="() => modelo.Nombre" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="modelo.Tipo">
                    @foreach (TipoEquipo tipo in Enum.GetValues(typeof(TipoEquipo)))
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => modelo.Tipo" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Estado Inicial <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="modelo.Estado">
                    <option value="@EstadoEquipo.Disponible">Disponible</option>
                    <option value="@EstadoEquipo.EnMantenimiento">En Mantenimiento</option>
                </InputSelect>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Crear Equipo")
                </button>
                <a href="/equipos" class="btn btn-secondary">Cancelar</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CrearEquipoDto modelo = new();
    private bool guardando = false;
    private string? mensajeError;

    private async Task GuardarAsync()
    {
        guardando = true;
        mensajeError = null;
        try
        {
            var creado = await ApiService.CrearAsync(modelo);
            Nav.NavigateTo($"/equipos/detalle/{creado.Id}");
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}
