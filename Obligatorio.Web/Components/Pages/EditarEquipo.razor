@page "/equipos/editar/{Id:int}"
@rendermode InteractiveServer
@inject ServicioEquipos ApiService
@inject NavigationManager Nav

<PageTitle>Editar Equipo</PageTitle>

<h2>Editar Equipo #@Id</h2>

<a href="/equipos/detalle/@Id" class="btn btn-secondary mb-3">← Volver al detalle</a>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

@if (cargando)
{
    <p>Cargando datos del equipo...</p>
}
else if (modelo == null)
{
    <div class="alert alert-warning">
        El equipo no fue encontrado o está inactivo.
        <a href="/equipos" class="btn btn-sm btn-secondary ms-2">Volver al listado</a>
    </div>
}
else
{
    <div class="card" style="max-width: 600px;">
        <div class="card-body">
            <EditForm Model="@modelo" OnValidSubmit="ActualizarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Nombre <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="modelo.Nombre" />
                    <ValidationMessage For="() => modelo.Nombre" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="modelo.Tipo">
                        @foreach (TipoEquipo tipo in Enum.GetValues(typeof(TipoEquipo)))
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => modelo.Tipo" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="modelo.Estado">
                        @foreach (EstadoEquipo estado in Enum.GetValues(typeof(EstadoEquipo)))
                        {
                            <option value="@estado">@estado</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => modelo.Estado" class="text-danger small" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar Cambios")
                    </button>
                    <a href="/equipos/detalle/@Id" class="btn btn-secondary">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ActualizarEquipoDto? modelo;
    private bool cargando = true;
    private bool guardando = false;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var equipo = await ApiService.ObtenerPorIdAsync(Id);
            if (equipo != null)
            {
                modelo = new ActualizarEquipoDto
                {
                    Nombre = equipo.Nombre,
                    Tipo = equipo.Tipo,
                    Estado = equipo.Estado
                };
            }
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ActualizarAsync()
    {
        if (modelo == null) return;
        guardando = true;
        mensajeError = null;
        try
        {
            await ApiService.ActualizarAsync(Id, modelo);
            Nav.NavigateTo($"/equipos/detalle/{Id}");
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}
